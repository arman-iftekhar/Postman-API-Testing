		{
			"name": "List of books",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", ()=> {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"//console.log(response[0].id);\r",
							"\r",
							"const nonFictionBooks = response.filter((book) => book.available === true);\r",
							"\r",
							"//console.log(nonFictionBooks[0].id);\r",
							"\r",
							"const book = nonFictionBooks[0];\r",
							"\r",
							"if(book){\r",
							"    pm.environment.set(\"bookId\", book.id);\r",
							"}\r",
							"\r",
							"pm.test(\"Book found\", ()=> {\r",
							"    pm.expect(book).to.be.an('object');\r",
							"    pm.expect(book.available).to.be.true;\r",
							"    pm.expect(book.available).to.eql(true); \r",
							"    //pm.expect(book.type).to.eql(\"non-fiction\");\r",
							"});\r",
							"\r",
							"\r",
							"//pm.globals.set(\"bookId\", nonFictionBooks[0]);\r",
							"//pm.globals.set(\"bookId\", book.id);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/books?type=non-fiction",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"books"
					],
					"query": [
						{
							"key": "type",
							"value": "non-fiction"
						},
						{
							"key": "limit",
							"value": "15",
							"disabled": true
						},
						{
							"key": "foo",
							"value": "asfhuyadiu",
							"disabled": true
						}
					]
				}
			},
			"response": []
		},
